{
  "name": "ai-search-agent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "strategy-pages": "node scripts/generate-strategy-pages.mjs",
    "new-page": "node scripts/new-page.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:pins": "vitest run tests/tool_attribution_audit_1763.test.ts tests/mesh_registry_s1_2322.test.ts tests/mesh_tool_registry_s14_2417.test.ts tests/oasf_records_2699.test.ts tests/thin_router_inventory.test.ts tests/neutrality_census_3525.test.ts tests/global_dd_census_2356.test.ts tests/trading_extraction_ledger.test.ts tests/policy_gate_guards.test.ts",
    "test:quarantine": "node scripts/run-quarantined.mjs",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:watch": "vitest",
    "check": "node scripts/gen-design-tokens.mjs --check && npm run typecheck && npm run test:ci && npm run build",
    "tokens:gen": "node scripts/gen-design-tokens.mjs",
    "parity": "node scripts/parity.mjs",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:audit": "node scripts/lint-changed.mjs --all",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.126",
    "@cloudflare/ai-chat": "0.12.0",
    "@cloudflare/think": "0.23.0",
    "@cloudflare/voice": "^0.5.0",
    "@e965/xlsx": "^0.20.3",
    "@fluentui/react-components": "^9.75.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "agents": "0.32.0",
    "ai": "7.0.123",
    "drizzle-orm": "^0.45.4",
    "mppx": "^0.13.1",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^2.7.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.2",
    "workers-ai-provider": "4.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "just-bash": "^3.6.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.3",
    "wrangler": "4.156.0"
  }
}
