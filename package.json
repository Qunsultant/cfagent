{
  "name": "ai-search-agent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "strategy-pages": "node scripts/generate-strategy-pages.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:quarantine": "node scripts/run-quarantined.mjs",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:watch": "vitest",
    "check": "node scripts/gen-design-tokens.mjs --check && npm run typecheck && npm run test:ci && npm run build",
    "tokens:gen": "node scripts/gen-design-tokens.mjs",
    "parity": "node scripts/parity.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.126",
    "@cloudflare/ai-chat": "0.12.0",
    "@cloudflare/think": "0.23.0",
    "@cloudflare/voice": "^0.5.0",
    "@e965/xlsx": "^0.20.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "agents": "0.32.0",
    "ai": "7.0.123",
    "drizzle-orm": "^0.45.4",
    "mppx": "^0.13.1",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^2.7.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.2",
    "workers-ai-provider": "4.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "wrangler": "4.156.0"
  }
}
