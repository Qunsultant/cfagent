{
  "name": "ai-search-agent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "strategy-pages": "node scripts/generate-strategy-pages.mjs",
    "new-page": "node scripts/new-page.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:quarantine": "node scripts/run-quarantined.mjs",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:watch": "vitest",
    "check": "node scripts/gen-design-tokens.mjs --check && npm run typecheck && npm run test:ci && npm run build",
    "tokens:gen": "node scripts/gen-design-tokens.mjs",
    "parity": "node scripts/parity.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.167",
    "@cloudflare/ai-chat": "0.12.2",
    "@cloudflare/think": "0.23.0",
    "@cloudflare/voice": "^0.5.0",
    "@e965/xlsx": "^0.20.3",
    "@fluentui/react-components": "^9.75.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "agents": "0.33.0",
    "ai": "7.0.163",
    "drizzle-orm": "^0.45.4",
    "mppx": "^0.17.1",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.16",
    "workers-ai-provider": "4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0"
  }
}
