{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-search-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  // Issue #4122 — cost guards taken from the two owner-supplied variants
  // (nextgentp-cost-optimized-wrangler{,-v2}). cpu_ms caps a runaway
  // invocation at 1s of CPU. The variants also proposed subrequests: 50,
  // deliberately NOT applied: 50 is the Free-plan ceiling, it changes nothing
  // there, and on a paid plan it would start failing the fan-out routes
  // (screener, discovery, report delivery).
  "limits": { "cpu_ms": 1000 },
  // The custom domain is the only intended front door; workers.dev stays
  // closed so stray subdomain traffic cannot bill.
  "workers_dev": false,
  "routes": [{ "pattern": "agent.openaimp.com", "custom_domain": true }],
  // Issue #329: only `/` and `/index.html` need the Worker (they inject the
  // session and render the landing page). Everything else that matches a file
  // — /assets/*, /strategies/*, /favicon.ico — is served by the asset layer
  // without invoking the Worker at all; routes that match no file still fall
  // through to it. The `serveStaticAsset` bypass in src/server.ts remains as
  // the safety net for anything that does land here.
  "assets": { "directory": "./dist/", "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  "workflows": [
    { "name": "trading-trade-workflow", "binding": "TRADE_WORKFLOW", "class_name": "TradingTradeWorkflow" },
    {
      "name": "screener-screen-workflow",
      "binding": "SCREENER_WORKFLOW",
      "class_name": "ScreenerScreenWorkflow"
      // Issue #4112 (owner direction): NO schedule. The workflow binding
      // stays so an on-demand run still resolves; to schedule it again,
      // add: "schedules": ["*/30 * * * *"]
    },
    { "name": "payment-workflow", "binding": "PAYMENT_WORKFLOW", "class_name": "PaymentWorkflow" },
    { "name": "saga-workflow", "binding": "SAGA_WORKFLOW", "class_name": "CrossDomainSagaWorkflow" },
    { "name": "job-pipeline-workflow", "binding": "JOB_PIPELINE_WORKFLOW", "class_name": "JobPipelineWorkflow" }
  ],
  // Issue #605 — report PDF blobs live in R2 (bucket provisioned by the
  // owner; reportBlobStore maps screener:*/options:* keys to stocks/*,
  // options/*). DO storage keeps only metadata pointers.
  "r2_buckets": [{ "binding": "REPORTS_BUCKET", "bucket_name": "screener" }],
  // Issue #1546 — D1 AgentDB (owner-created): shared cross-agent query
  // projection. DO storage stays authoritative for execution state.
  "d1_databases": [{ "binding": "AGENT_DB", "database_name": "agentdb", "database_id": "8d1bebf1-b2c4-4a55-8673-03140afb8023" }],
  // Issue #1743 — Analytics Engine dataset for the observability
  // stream (owner-provisioned dataset name; unbound degrades to
  // local logging, never fails the request).
  "analytics_engine_datasets": [{ "binding": "OBSERVABILITY", "dataset": "observability" }],
  "ai": { "binding": "AI" },
  // Issue #2253 — Browser Rendering for the browser tooling:
  // src/services/browserAgent.ts reads env.BROWSER (types.ts declares
  // BROWSER?: Fetcher); without this declaration the deployed config
  // can never serve the real capture path and captures fall back to
  // the labelled placeholder (mesh survey G11 finding).
  "browser": { "binding": "BROWSER" },
  // Issue #2889 (follow-up to Adapter S4 #1778, program #1717) —
  // Email Sending binding for outbound mail: src/services/
  // cloudflareEmailSender.ts calls env.EMAIL.send; without this
  // declaration the deployed config can never serve the real send
  // path and sends fall back to fail-soft false. Wrangler 4 schema:
  // send_email items carry `name` (the env binding name).
  // Account-side Email Sending provisioning is the owner step that
  // unblocked this declaration; no destination restriction is set,
  // so sends keep the adapter's existing From/recipient behaviour.
  "send_email": [{ "name": "EMAIL" }],
  // Issue #1739 — queue-backed messaging. The work queue is
  // producer-only in this slice (its consumer arrives with the first
  // job handler); only the delivery subscriber queue has a consumer.
  // No dead-letter queue is wired yet — DLQ wiring lands with the
  // first job consumer (see ADR 0003).
  "queues": {
    "producers": [
      // Issue #3534 (Pipeline J1) — the job-pipeline pub/sub queue.
      // Producer-only in this slice (its consumer arrives with the
      // first job handler in J2, the #1739 sequencing); the
      // composition root is src/messaging/createJobPipelineMessaging.ts
      // and absence is the named state job_pipeline_queue_not_configured.
      { "binding": "JOB_PIPELINE_EVENTS", "queue": "job-pipeline-events" },
      { "binding": "JOB_PIPELINE_EVENTS_DLQ", "queue": "job-pipeline-events-dlq" },
      { "binding": "SCREENER_EVENTS", "queue": "screener-events" },
      { "binding": "SCREENER_EVENTS_DELIVERY", "queue": "screener-events-delivery" },
      { "binding": "SCREENER_EVENTS_DLQ", "queue": "screener-events-dlq" },
      { "binding": "SCREENER_DELIVERY_DLQ", "queue": "screener-events-delivery-dlq" }
    ],
    "consumers": [
      // Issue #3543 (Pipeline J1 host wiring, consumed by J2 #3535):
      // the job-pipeline-events consumer arrives with its first
      // handler (the #1739 sequencing) — completions route to the
      // ScheduledAgent host. Its settings are the
      // JOB_PIPELINE_EVENTS_CONSUMER_CONFIG pin in
      // src/messaging/jobPipelineEventsConsumer.ts.
      { "queue": "job-pipeline-events", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3, "dead_letter_queue": "job-pipeline-events-dlq", "max_concurrency": 2 },
      // Issue #2544 (Cloudflare migration step 1, report §3.2): the
      // work queue finally has a consumer, and both consumers have
      // dead-letter queues. The delivery consumer keeps its
      // max_batch_size/max_retries and gains a DLQ + concurrency cap.
      { "queue": "screener-events", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 3, "dead_letter_queue": "screener-events-dlq", "max_concurrency": 4 },
      { "queue": "screener-events-delivery", "max_batch_size": 10, "max_retries": 3, "dead_letter_queue": "screener-events-delivery-dlq", "max_concurrency": 2 }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ORCHESTRATOR_AGENT", "class_name": "OrchestratorAgent" },
      {
        "name": "OPTIONS_SCANNER_MCP",
        "class_name": "OptionsScannerMCP"
      },
      // PR #3 — x402 PaymentsAgent DO (ledger + budget guards)
      { "name": "PAYMENTS_AGENT", "class_name": "PaymentsAgent" },
      // PR #4 — ScheduledAgent DO (autonomous cron-driven goals)
      { "name": "SCHEDULED_AGENT", "class_name": "ScheduledAgent" },
      // Issue #261 — ScreenerAgent DO (one agent, one UI, E*TRADE-only)
      { "name": "SCREENER_AGENT", "class_name": "ScreenerAgent" },
      // Issue #319 — ResearchAgent DO (autonomous options research)
      { "name": "RESEARCH_AGENT", "class_name": "ResearchAgent" },
      // Issue #329 — sessions + E*TRADE credentials off KV (Durable Objects SQLite limits DO apply: 5M rows read/day, 100k writes/day — see #1819; #2666 resilience keeps sign-in degraded, never down, on exhaustion)
      { "name": "SESSION_STORE", "class_name": "SessionStore" },
      // Issue #680 — ReportAssetAgent DO (single owner for Generate)
      { "name": "REPORT_ASSET_AGENT", "class_name": "ReportAssetAgent" },
      // Issue #291 — TradingAgent DO (provider-neutral trading competency)
      { "name": "TRADING_AGENT", "class_name": "TradingAgent" },
      // Issue #1387 — the OrchestratorAgent root namespace (v9) that
      // used to be bound here is tombstoned by migration v14 (#2330,
      // Agent Mesh S2-A): the legacy Delete-migration procedure removes
      // the binding in the same change as the deleted_classes entry.
      // Deploy B (#2326) renames the SearchAgent namespace onto
      // OrchestratorAgent; sub-agent root resolution via ctx.exports is
      // unavailable in the A→B window by design (accepted cost, #2326).
      // Issue #2215 — BrowserAgent + SlackAgent DO bindings (Think agents
      // via PortThink; server.ts already exports both classes).
      { "name": "BROWSER_AGENT", "class_name": "BrowserAgent" },
      { "name": "SLACK_AGENT", "class_name": "SlackAgent" },
      // Issue #2230 — TickerAgent DO (market quotes WebSocket, PortThink)
      { "name": "TICKER_AGENT", "class_name": "TickerAgent" },
      // Issue #2223 — AiSearchAgent DO (AI Search as an agent: namespace
      // binding primary, REST fallback; the MCP path is deliberately
      // unconfigured — owner decision, no public endpoint). The
      // ai_search_namespaces binding is declared below (namespace
      // "default", owner-provided 2026-11-05 under #1169; see
      // src/types.ts AI_SEARCH).
      { "name": "AI_SEARCH_AGENT", "class_name": "AiSearchAgent" },
      // Issue #2253 / #3492 — SandboxAgent DO (fleet registration:
      // delegates to ETradeSandboxService with bound container backend).
      { "name": "SANDBOX_AGENT", "class_name": "SandboxAgent" }
    ]
  },
  // Issue #4112 (owner direction): the deployment provisions NO container.
  // Cloudflare Containers bill while the application exists, and the
  // deploy-time strip in scripts/ci/deploy-worker.mjs (#3789) only fires
  // AFTER a 403 - with Containers permission on the token the block ships.
  // To re-enable, uncomment and keep the sizing: ONE instance, smallest type.
  // "containers": [
  //   {
  //     "class_name": "SandboxAgent",
  //     "scheduling_policy": "durable_object",
  //     "max_instances": 1,
  //     "instance_type": "lite"
  //   }
  // ],
  // Issue #1169 (owner enablement, 2026-11-05) — the AI Search
  // namespace binding the AiSearchAgent namespace path reads
  // (env.AI_SEARCH.get(AI_SEARCH_INSTANCE)); the instance
  // "screener-search" lives in the "default" namespace.
  "ai_search_namespaces": [
    { "binding": "AI_SEARCH", "namespace": "default", "remote": true }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SearchAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["OptionsScannerMCP"] },
    // PR #3 + PR #4 — new SQLite DO classes
    { "tag": "v3", "new_sqlite_classes": ["PaymentsAgent", "ScheduledAgent"] },
    // Issue #261 — ScreenerAgent
    { "tag": "v4", "new_sqlite_classes": ["ScreenerAgent"] },
    // Issue #319 — ResearchAgent
    { "tag": "v5", "new_sqlite_classes": ["ResearchAgent"] },
    // Issue #329 — SessionStore (sessions + credentials)
    { "tag": "v6", "new_sqlite_classes": ["SessionStore"] },
    // Issue #680 — ReportAssetAgent
    { "tag": "v7", "new_sqlite_classes": ["ReportAssetAgent"] },
    // Issue #291 — TradingAgent
    { "tag": "v8", "new_sqlite_classes": ["TradingAgent"] },
    // Issue #1387 — OrchestratorAgent root namespace for sub-agent bootstrap
    { "tag": "v9", "new_sqlite_classes": ["OrchestratorAgent"] },
    // Issue #2215 — BrowserAgent + SlackAgent bindings
    { "tag": "v10", "new_sqlite_classes": ["BrowserAgent", "SlackAgent"] },
    // Issue #2230 — TickerAgent
    { "tag": "v11", "new_sqlite_classes": ["TickerAgent"] },
    // Issue #2223 — AiSearchAgent binding (v12: v11 was taken by #2230's
    // TickerAgent, which landed while this slice was building)
    { "tag": "v12", "new_sqlite_classes": ["AiSearchAgent"] },
    // Issue #2253 — SandboxAgent binding
    { "tag": "v13", "new_sqlite_classes": ["SandboxAgent"] },
    // Issue #2330 — Agent Mesh S2-A (two-deploy rename, step 1 of 2;
    // gate record #2326): tombstone the v9 OrchestratorAgent namespace
    // so Deploy B can rename SearchAgent → OrchestratorAgent without
    // hitting tombstone_renamed_to_occupied. Deletes the v9 namespace
    // and all of its stored data — owner-verified as holding no live
    // state worth keeping before this deploy is allowed to land.
    { "tag": "v14", "deleted_classes": ["OrchestratorAgent"] },
    // Issue #2523 — Agent Mesh S2-B (two-deploy rename, step 2 of 2;
    // gate record #2326): rename the SEARCH_AGENT namespace onto
    // OrchestratorAgent. The target name is free because v14
    // tombstoned the colliding v9 registration in Deploy A (#2330).
    // Instance names (logins) and stored state carry over per
    // renamed_classes semantics; the SEARCH_AGENT binding name does
    // not change — only its class_name does (above). Issue #2570
    // later finished the rename on the binding side: the binding is
    // now named ORCHESTRATOR_AGENT (same class_name). Binding names
    // are not namespace keys — namespaces are per class — so no
    // migration accompanies the binding rename and the per-login
    // instances and their stored state are untouched by it.
    { "tag": "v15", "renamed_classes": [{ "from": "SearchAgent", "to": "OrchestratorAgent" }] }
  ],
  // Issue #606 (phase 4 of #415): no KV binding is declared — sessions and
  // E*TRADE credentials live in the SessionStore DO (#329), report PDFs
  // in R2 (#605). Correction (#4120, audit 2026-11-11): two namespaces DO
  // still exist in the account — AGENT_SESSIONS and SESSIONS — unbound and
  // unused by this Worker. Deleting them is an owner action on Cloudflare,
  // not a manifest change; the earlier "deleted owner-side" note was wrong.
  // Issue #257 (Assessment P1): explicit Workers Logs pipeline. `enabled` is the
  // shorthand for logs.enabled; `invocation_logs` captures one log per
  // invocation (request/response metadata + console output) visible under
  // Observability > Logs. head_sampling_rate 1 = 100% sampled. No external
  // destinations configured (no OpenTelemetry destination exists in the
  // dashboard) — see docs/OBSERVABILITY.md.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  // Issue #4112 (owner direction): NO schedules and NO triggers. Every cron
  // entry is commented out, so nothing fires - no ScheduledAgent tick, no
  // nightly research run, no retention pass. The scheduled() handler and
  // resolveCronEntryPoint stay in code and become unreachable, so restoring a
  // schedule is an uncomment here, not a code change.
  // "triggers": {
  //   "crons": [
  //     "0 3 * * *",
  //     "*/30 * * * *",
  //     "0 4 * * *"
  //   ]
  // },
  // PR #6 — Vectorize for VectorMemory
  "vectorize": [
    {
      "binding": "VECTOR_MEMORY",
      "index_name": "vector-memory"
    }
  ],
  // Issue #1806, #1815, #1817 — Cloudflare Flagship feature flags binding
  // App: IROS (app_id: 14c0030d-3a98-44ef-91b3-fb5024972c76).
  // Native OpenFeature evaluation via env.FLAGS in src/features/cfFlagshipAdapter.ts.
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "14c0030d-3a98-44ef-91b3-fb5024972c76"
    }
  ],
  "vars": {
    // Issue #1169 (owner enablement, 2026-11-05): the instance the
    // namespace path searches. Issue #3342 deleted the former
    // AI_SEARCH_ENDPOINT var: every consumer migrated onto the
    // private ai_search_namespaces binding, so the instance's
    // public endpoint carries no app traffic and the owner can
    // disable it in the dashboard. AI_SEARCH_MCP_ENDPOINT is
    // deliberately NOT set (owner decision, 2026-11-05): the
    // instance's Public Endpoint is an unauthenticated, shareable
    // URL, so the MCP path stays unconfigured and no traffic uses
    // the public endpoint.
    "AI_SEARCH_INSTANCE": "screener-search",
    // Issue #278: TTL cache for AI Search queries (in-isolate, per the
    // cache module's honesty note). 300000 = 5 minutes; 200 entries.
    "AI_SEARCH_CACHE_TTL_MS": "300000",
    "AI_SEARCH_CACHE_MAX_ENTRIES": "200",
    // Issue #1169 enablement (owner direction 2026-11-04): knowledge
    // serving and AI Search report indexing are ON. The
    // ai_search_namespaces binding + instance configuration landed
    // 2026-11-05 (owner-provided namespace "default", instance
    // screener-search), so the indexing leg uploads through the
    // namespace path; it never fails a report store.
    // Rollback is removing the ai_search_namespaces entry and
    // unsetting these vars (the two flags, AI_SEARCH_INSTANCE),
    // then redeploying.
    "KNOWLEDGE_SERVING_ENABLED": "1",
    "AI_SEARCH_REPORT_INDEXING_ENABLED": "1",
    // Issue #3375 — corpus indexing enablement: the #3345 corpus
    // items-API bridge is ON in production. Corpus writes and the
    // corpus sync ALSO upload each corpus document to the instance
    // through the bridge (best-effort, never failing the write or
    // the sync), and the Corpus tab reports per-item indexing state
    // as indexed. Rollback is unsetting this var and redeploying.
    "AI_SEARCH_CORPUS_INDEXING_ENABLED": "1",
    // Issue #3413 — Stock Copilot enablement (owner direction
    // 2026-11-05): the pattern-driven paper-trading loop from
    // #3391 is ON in production. Paper-only by construction —
    // its guard refuses any live Alpaca configuration — and it
    // declares itself only on instances holding a screener
    // execution context. The universe defaults to
    // SPY/QQQ/AAPL/MSFT/NVDA unless STOCK_COPILOT_UNIVERSE is
    // set. Rollback is unsetting this var and redeploying.
    "STOCK_COPILOT_PAPER_ENABLED": "1",
    // Issue #3728: Unconstrained continuous Stock Copilot trading around the clock (24/7).
    // Issue #4122 — cost: idle outside market hours instead of polling all day.
    "STOCK_COPILOT_AROUND_THE_CLOCK": "false",
    // Issue #3727 — copilot capability enablement (owner direction
    // 2026-11-07): every capability-gating switch is externalized
    // here and set so the copilots are fully functional/enabled —
    // no constraints. AGENT_CAPABILITIES_DISABLED is explicitly
    // EMPTY (nothing disabled; the capability-manifest resolver's
    // override list parses to zero entries), and SCREENER_ND_MODE
    // "on" admits non-deterministic screen runs at the mesh doors
    // (each run still requires its own explicit screenMode +
    // screenIntent). Rollback is removing these vars and
    // redeploying.
    // Issue #3740 — NLQ vs chat is a CHOICE (owner correction
    // 2026-11-08): chat is the default turn mode, so
    // CHAT_NLQ_MODE is "off" — the discovered execute_nlq tool
    // stays out of chat/copilot turns' usable set by default.
    // The var stays externalized (the env level of the
    // src/config/chatNlqModes.ts chain keeps working) and a
    // per-user override can still select NLQ "on". Rollback is
    // setting CHAT_NLQ_MODE back to "on" and redeploying.
    "AGENT_CAPABILITIES_DISABLED": "",
    // Issue #3741 — the one resolver's operator pins
    // (src/services/agentConfigResolver.ts): explicitly EMPTY —
    // nothing is pinned; a pin ("<scope>:<entryId>") would freeze
    // that entry at the operator layer and refuse lower-layer
    // writes by name.
    "AGENT_CONFIG_PINS": "",
    "CHAT_NLQ_MODE": "off",
    "SCREENER_ND_MODE": "on",
    // Issue #3738 — per-copilot channel switches (owner direction
    // 2026-11-08): channel enablement per copilot registration is
    // externalized and resolved stored > env > code default
    // (src/services/copilotChannels.ts). Production value: the
    // Stock Copilot's voice channel is ON, carried explicitly by
    // this layer (a login's stored channel setting still wins over
    // it). Rollback is removing the entry (the code default for
    // stock:voice is also on) or setting it to "stock:voice=off",
    // and redeploying.
    "COPILOT_CHANNELS": "stock:voice=on",
    // Issue #3773 — the copilot voice channel's BACKEND switch
    // (src/services/copilotVoiceBackend.ts): entries
    // "<registration>=webspeech|model". Production value: empty —
    // no env-layer decision, so every registration resolves to the
    // code default (webspeech, browser Web Speech); a login's
    // stored backend setting still wins over this layer. Set e.g.
    // "stock=model" to serve a registration's voice turns from the
    // Workers AI STT/TTS models instead, and redeploy.
    "COPILOT_VOICE_BACKEND": "",
    // Issue #3452 — Stock Copilot cycle cadence (AOP). Optional;
    // absence uses "every 30 minutes". Floor is 30m (Worker cron limit).
    // "STOCK_COPILOT_CADENCE": "every 30 minutes",
    "APP_NAME": "NextGenTP",
    // Issue #2419 — externalized polling cadences (AOP). All optional;
    // absence means the pollingConfig defaults apply. Milliseconds,
    // except CHAT_AUTO_REFRESH_FLOOR_S (seconds, matching the stored
    // user interval). Rollback is unsetting the vars and redeploying.
    "QUOTES_REST_FALLBACK_MS": "60000",
    "QUOTES_WS_RECONNECT_BASE_MS": "1000",
    "QUOTES_WS_RECONNECT_CAP_MS": "30000",
    // Issue #4122 — cost: 30s -> 300s between options-flow polls.
    "OPTIONS_FLOWS_POLL_MS": "300000",
    // Issue #4122 — cost: 60s -> 300s between latest-options polls.
    "OPTIONS_LATEST_POLL_MS": "300000",
    "CHAT_AUTO_REFRESH_FLOOR_S": "5",
    "GOAL_TRACK_POLL_MS": "2000",
    "GOAL_TRACK_DEADLINE_MS": "600000",
    // Issue #2443 — TickerAgent push cadence, seconds. Default 5s;
    // changing it changes live tick cadence (product call). Rollback
    // is unsetting the var and redeploying.
    // Issue #4122 — cost: 5s -> 60s cuts ticker DO activity (variants: 92%).
    "TICKER_PUSH_INTERVAL_S": "60",
    "MAS_MAX_STEPS": "4",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CF_WALLET_NETWORK": "base-sepolia",
    "CF_WALLET_FACILITATOR": "https://x402.org/facilitator",
    "_comment_wallet": "Set CF_WALLET_RECIPIENT via: wrangler secret put CF_WALLET_RECIPIENT",
    // Issue #945, Wiring Phase 1 enablement (PR #965 merged the code
    // default-off): GitHub login/session wiring ON in production.
    // Rollback is removing these two vars (or setting
    // IAAA_WIRING_ENABLED to "0") and redeploying — no code change.
    // Google login enabled (owner-authorized; OAuth client + PROD
    // secrets set). Rollback is removing google from the list below
    // and redeploying — no code change.
    "IAAA_WIRING_ENABLED": "1",
    // Issue #2444 — wired session freshness gate (DO request meter).
    // A cached wired session fetched within this window (ms) is served
    // without a fresh store read. Default 30s when unset. SECURITY
    // TRADE-OFF: revocation/step-up propagation is delayed up to the
    // window (CISO domain, #945 open item) — merge sign-off on this
    // value belongs to the owner/CISO. Rollback is setting this to
    // "0" (gating disabled) and redeploying — no code change. NOTE:
    // removing the var does NOT disable gating (the code default is
    // 30s); only "0" disables it.
    "IAAA_WIRED_FRESHNESS_MS": "30000",
    // Issue #3155 (Q9) — default grant lifetime in days for
    // non-platform-scope bindings without an explicit expiry.
    // Adopted initial value 90; "0" resolves to 90, never to
    // unbounded (see src/security/grantRules.ts).
    "IAAA_GRANT_DEFAULT_EXPIRY_DAYS": "90",
    "IAAA_ENABLED_PROVIDERS": "github,google",
    // Issue #945, GitHub activation (owner-authorized, updated 2026-10-23
    // after #1182 stable identity): bootstrap the owner by issuer:subject
    // entries — platform: entry for the genesis platform-admin grant on the
    // next wired login, plain entry for tenant-admin in primary (unblocks
    // E*TRADE PDP). Replaces the retired minted-UUID entry: post-#1182
    // logins carry derived ids, so the minted entry could never match again.
    // Tenant stays at the documented
    // default "primary". Rollback is removing these two vars (or
    // setting IAAA_PDP_ENABLED to "0") and redeploying — no code
    // change; granted memberships are NOT deleted by rollback.
    "IAAA_BOOTSTRAP_ADMINS": "platform:https://github.com:82253453,https://github.com:82253453",
    "IAAA_PDP_ENABLED": "1",
    // Issue #2800 (owner-directed, interim bootstrap): make the
    // commercial URLs work for the owner login OpenAIMP for now.
    // Env operator list for the commercial routes (UNION the store
    // operator list; empty = deny all). Plain login list, not a
    // credential — vars is the right home by repo convention
    // (precedent: IAAA_BOOTSTRAP_ADMINS above). Interim: once an
    // operator exists, the durable list is managed through the UI
    // (/operators/add); this entry can be removed by a follow-up
    // PR + redeploy. Rollback is removing this var and
    // redeploying — no code change.
    "COMMERCIAL_STORE_OPERATORS": "OpenAIMP",
    // Issue #1077, real-post test (owner-authorized go-live): social
    // posting ON + live publishing ON. Daily goal stays DISABLED, so
    // nothing auto-fires — a live post happens only via manual
    // trigger. No token → live publish errors honestly, never a
    // silent dry-run. Rollback is removing these two vars (or setting
    // them to "0") and redeploying — no code change.
    // Issue #4122 — cost: no autonomous social posting.
    "SOCIAL_POSTING_ENABLED": "0",
    // Issue #4122 — cost: no live social publishing.
    "SOCIAL_LIVE_PUBLISHING": "0",
    // Issue #1489: scope autonomous publishing to Threads only during
    // Threads-first rollout. Without this, config defaults to "threads,x",
    // attempting to publish to X where X_ACCESS_TOKEN is not configured.
    "SOCIAL_AUTONOMOUS_CHANNELS": "threads",
    // Issue #1475 (sub-issue of #1344), service identity for unattended
    // work (runbook docs/architecture/security/service-identity.md):
    // the login scheduled goals and ledger forwards run under. Plain
    // identifier, not a credential — never routed through secrets sync.
    // Value follows the repo's own convention for the generic service
    // identity (tests/service_identity.test.ts). Rollback is removing
    // this var (or blanking it) and redeploying — goals return to
    // failing closed at the budget check.
    "SERVICE_USER_LOGIN": "svc-background",
    // Issue #1806: Cloudflare feature flags — screener enabled first.
    // "1" or "true" = ON. All other features default to closed (OFF).
    // Rollback is removing this var (or setting to "0") and redeploying,
    // or toggling off in Cloudflare Flagship without redeploying.
    "FEATURE_SCREENER": "1",
    // Issue #2051: goal_workflow ON by default (opt-out). The staged
    // goal path + #1998 gather run unless explicitly disabled
    // (Flagship toggle off, or this var to "0", + redeploy).
    "FEATURE_GOAL_WORKFLOW": "1",
    // Issue #2054: PaymentWorkflow assurance page ON by default
    // (owner direction). Covers runtimes without the FLAGS binding;
    // in PROD the FLAGS binding takes precedence, so the adapter
    // default in cfFlagshipAdapter.ts is what turns it on there.
    // Rollback is setting this var to "0" and redeploying (explicit
    // disable wins over the default in every adapter).
    "FEATURE_PAYMENT_ASSURANCE": "1",
    // Issue #2596: Options Screener product programme slice 1.
    // Enables the top-level Options Screener nav item and sub-menus.
    // Rollback is removing this var (or setting to "0") and redeploying.
    "FEATURE_OPTIONS_SCREENER": "1",
    // Issue #2742: Flagship monetization flag enabled (owner direction).
    // Native payment workflow and charging active by default.
    // Rollback is setting this var to "0" (or toggling off in Flagship dashboard).
    "FEATURE_MONETIZATION": "1",
    // Issue #3491 / #3492 / #3779 — Sandbox & Workspace enablement
    // Issue #4122 (owner direction): the sandbox has no container (#4112),
    // so the flag is off — the variants put it at "0" for the same reason.
    "FEATURE_SANDBOX": "0",
    "FEATURE_WORKSPACE": "1",
    "WORKSPACE_ROOT": "/workspace"
  }
}
